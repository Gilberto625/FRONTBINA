# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-app.onrender.com

# Database PostgreSQL
DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://tu-frontend.com
CSRF_TRUSTED_ORIGINS=http://localhost:4200,https://tu-frontend.com

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-email@gmail.com

# Firebase
FIREBASE_PROJECT_ID=auth-backend-tu-nombre

# Para Render (PostgreSQL internal URL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
